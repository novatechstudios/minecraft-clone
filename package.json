{
  "name": "minecraft-clone",
  "version": "1.0.0",
  "description": "Hello World!",
  "main": "run.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "author": "MOJANG",
  "license": "MIT",
  "dependencies": {
    "noisejs": "^2.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mojang.minecraft",
    "productName": "Minecraft",

    "directories": {
      "output": "build"
    },

    "extraResources": [
      {
        "from": "mods",
        "to": "mods"
      },
      {
        "from": "saves",
        "to": "saves"
      }
    ],

    "win": {
      "target": "portable"
    },

    "linux": {
      "target": "deb"
    }
  }
}
